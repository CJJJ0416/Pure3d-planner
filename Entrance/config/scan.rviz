# RViz 布局：SCAN 与 Faster-LIO 建图显示；a1.launch.py、rviz.launch.py、rviz_real.launch.py 共用。
# 注意：在 RViz 中保存布局会重写本文件，注释可能被丢弃。
Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Faster-LIO accumulated scans (120 s)1/Autocompute Value Bounds1
        - /Faster-LIO current scan1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 865
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded: ~
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
