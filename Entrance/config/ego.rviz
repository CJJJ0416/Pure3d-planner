# RViz 布局：EGO/PCT 规划器显示（planner:=ego 时由 gazebo.launch.py 经 _internal/a1.launch.py 加载）。
# 注意：在 RViz 中保存布局会重写本文件，注释可能被丢弃。
Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Planning1/goal_point1
        - /Planning1/global_path1
        - /Planning1/optimal_traj1
        - /Planning1/InitTraj1
        - /Mapping1/simulation_map1
        - /Mapping1/map inflate1
        - /Simulation1/robot1
        - /Odometry1/Shape1
        - /PointCloud21/Topic1
        - /PointCloud21/Autocompute Value Bounds1
      Splitter Ratio: 0.5
    Tree Height: 651
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
      - /ThirdPersonFollower1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: PointCloud2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.20000000298023224
      Cell Size: 2
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
