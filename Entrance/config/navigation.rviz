# RViz 布局：人工目标与整图 A* 导航显示（navigation.launch.py rviz:=true）。
# 注意：在 RViz 中保存布局会重写本文件，注释可能被丢弃。
Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Traversability cost1
      Splitter Ratio: 0.5
    Tree Height: 362
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Tool Properties
    Expanded: ~
    Name: Tool Properties
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 80; 90; 100
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Map grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 60
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.20000000298023224
      Autocompute Intensity Bounds: false
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 150; 170; 190
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Invert Rainbow: false
      Max Color: 240; 45; 35
      Max Intensity: 1
      Min Color: 20; 200; 60
      Min Intensity: 0
      Name: Accumulated geometry
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 1
      Size (m): 0.03999999910593033
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /entry/rviz/cloud
      Use Fixed Frame: true
      Use rainbow: false
      Value: false
    - Alpha: 1
      Autocompute Intensity Bounds: false
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: trav_cost
      Class: rviz_default_plugins/PointCloud2
      Color: 150; 170; 190
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 240; 45; 35
      Max Intensity: 1
      Min Color: 20; 200; 60
      Min Intensity: 0
      Name: Traversability cost
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.10000000149011612
      Style: Tiles
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /entry/rviz/cost_cloud
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 0.8500000238418579
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 40; 220; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: SCAN local occupancy
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.05000000074505806
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan/grid_map/occupancy
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 0.25
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 160; 50
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: SCAN inflated occupancy - optional
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 1
      Size (m): 0.05000000074505806
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan/grid_map/occupancy_inflate
      Use Fixed Frame: true
      Use rainbow: true
      Value: false
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: SCAN sliding map bounds
      Namespaces:
        sliding_map: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /scan/grid_map/sliding_map_bbox
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: EDEN style blocks
      Namespaces:
        {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /entry/blocks
      Value: false
    - Class: rviz_default_plugins/InteractiveMarkers
      Enable Transparency: true
      Enabled: true
      Interactive Markers Namespace: /entry_navigation_controls
      Name: Human GOAL - drag and release
      Show Axes: false
      Show Descriptions: true
      Show Visual Aids: false
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Global path labels
      Namespaces:
        global_path_label: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /entry/navigation/markers
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: SCAN local trajectory
      Namespaces:
        "": true
      Topic:
        Depth: 20
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /scan/optimal_list
      Value: true
    - Alpha: 0.8500000238418579
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: false
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Surface A* cells - height
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.05000000074505806
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /entry/surface_cloud
      Use Fixed Frame: true
      Use rainbow: true
      Value: false
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 70; 180; 255
      Enabled: true
      Head Diameter: 0.30000001192092896
      Head Length: 0.20000000298023224
      Length: 0.30000001192092896
      Line Style: Lines
      Line Width: 0.03500000014901161
      Name: A* global path - SCAN input
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.029999999329447746
      Shaft Diameter: 0.10000000149011612
      Shaft Length: 0.10000000149011612
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /entry/astar_path
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 80; 190
      Enabled: false
      Head Diameter: 0.30000001192092896
      Head Length: 0.20000000298023224
      Length: 0.30000001192092896
      Line Style: Lines
      Line Width: 0.06499999761581421
      Name: GPMP global path - optional
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.029999999329447746
      Shaft Diameter: 0.10000000149011612
      Shaft Length: 0.10000000149011612
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /entry/gpmp_path
      Value: false
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
        FL_calf:
          Value: true
        FL_foot:
          Value: true
        FL_hip:
          Value: true
        FL_thigh:
          Value: true
        FL_thigh_shoulder:
          Value: true
        FR_calf:
          Value: true
        FR_foot:
          Value: true
        FR_hip:
          Value: true
        FR_thigh:
          Value: true
        FR_thigh_shoulder:
          Value: true
        RL_calf:
          Value: true
        RL_foot:
          Value: true
        RL_hip:
          Value: true
        RL_thigh:
          Value: true
        RL_thigh_shoulder:
          Value: true
        RR_calf:
          Value: true
        RR_foot:
          Value: true
        RR_hip:
          Value: true
        RR_thigh:
          Value: true
        RR_thigh_shoulder:
          Value: true
        base:
          Value: true
        body:
          Value: true
        camera_init:
          Value: true
        imu_link:
          Value: true
        laser_livox:
          Value: true
        livox_imu_link:
          Value: true
        map:
          Value: true
        scan_sliding_map:
          Value: true
        trunk:
          Value: true
        world:
          Value: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        world:
          base:
            laser_livox:
              livox_imu_link:
                {}
            trunk:
              FL_hip:
                FL_thigh:
                  FL_calf:
                    FL_foot:
                      {}
                FL_thigh_shoulder:
                  {}
              FR_hip:
                FR_thigh:
                  FR_calf:
                    FR_foot:
                      {}
                FR_thigh_shoulder:
                  {}
              RL_hip:
                RL_thigh:
                  RL_calf:
                    RL_foot:
                      {}
                RL_thigh_shoulder:
                  {}
              RR_hip:
                RR_thigh:
                  RR_calf:
                    RR_foot:
                      {}
                RR_thigh_shoulder:
                  {}
              imu_link:
                {}
          map:
            camera_init:
              body:
                {}
          scan_sliding_map:
            {}
      Update Interval: 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 24; 29; 38
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /scan/goal
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Distance: 8.733759880065918
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 6.343709945678711
        Y: -0.9340663552284241
        Z: -0.30896472930908203
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.18000102043151855
      Target Frame: base
      Value: ThirdPersonFollower (rviz_default_plugins)
      Yaw: 6.140086650848389
    Saved: ~
Window Geometry:
  Displays:
    collapsed: true
  Height: 1016
  Hide Left Dock: true
  Hide Right Dock: false
  QMainWindow State: 
  Tool Properties:
    collapsed: true
  Views:
    collapsed: true
  Width: 925
  X: 70
  Y: 27
