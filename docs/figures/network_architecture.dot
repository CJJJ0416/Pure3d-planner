digraph Pure3D {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.4, ranksep=0.45, fontname="Noto Sans CJK SC", label="Pure3D 在线局部代价与导航", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fillcolor="#e2e8f0", margin="0.18,0.12"];
  edge [fontname="Noto Sans CJK SC"];
  lio [label="Faster-LIO
注册点云与校准后的机身位姿"];
  context [label="LIO 独立 6×6×5 m 盒子
0.05 m 体素与稳定已观测上下文"];
  knn [label="KNN 孤立点过滤
统计异常且半径邻域稀疏"];
  encoder [label="PTv3 / Utonia
4×4×3 m core + 1 m context", fillcolor="#dbeafe"];
  cost [label="FiLM + cost head", fillcolor="#dbeafe"];
  robot [label="机器人条件
[0.5, 0.4, 0.2, 0.0]", fillcolor="#fef3c7"];
  cloud [label="局部 XYZ + trav_cost", fillcolor="#dcfce7"];
  goal [label="人工 InteractiveMarker goal", fillcolor="#fef3c7"];
  astar [label="代价点云 A*
严格 cost < 0.8"];
  scan [label="/pure_path → SCAN
占用与局部 B-spline → 控制"];
  lio -> context -> knn -> encoder -> cost -> cloud -> astar -> scan;
  robot -> cost;
  goal -> astar;
}
