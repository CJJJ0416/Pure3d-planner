    Enabled: false
    Value: false
    Alpha: 1.0
    Position Transformer: XYZ
    Color Transformer: Intensity
    Color: 150; 170; 190
    Channel Name: keep_target
    Autocompute Intensity Bounds: false
    Min Intensity: 0.0
    Max Intensity: 1.0
    Use rainbow: false
    Min Color: 230; 40; 40
    Max Color: 30; 180; 90
    Style: Points
    Size (Pixels): 1
    Size (m): 0.085
    Decay Time: 0
    Use Fixed Frame: true
