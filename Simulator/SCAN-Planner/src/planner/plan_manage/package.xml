<?xml version="1.0"?>
<package format="3">
  <name>scan_planner</name>
  <version>0.1.0</version>
  <description>SCAN-Planner ROS 2 nodes, controllers, launch and configuration.</description>
  <maintainer email="iszhouxin@zju.edu.cn">SCAN-Planner maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ament_index_cpp</depend>
  <exec_depend>ament_index_python</exec_depend>
  <depend>scan_bspline_opt</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>interactive_markers</depend>
  <depend>nav_msgs</depend>
  <depend>scan_path_searching</depend>
  <depend>scan_plan_env</depend>
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>scan_planner_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>scan_traj_utils</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
